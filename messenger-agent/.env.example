# Meta app (developers.facebook.com → your app → Messenger settings)
FACEBOOK_VERIFY_TOKEN=any_random_string_you_choose   # you invent this; paste the same in Meta's dashboard
FACEBOOK_APP_SECRET=                                 # App settings → Basic → App Secret (for signature checks)
PAGE_ACCESS_TOKEN=                                   # generated per page in Messenger settings

# Chatwoot Integration (Settings → Integrations → Webhooks)
# Webhook URL: https://your.host/chatwoot/<CHATWOOT_WEBHOOK_SECRET>
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=
CHATWOOT_WEBHOOK_SECRET=your_long_random_webhook_secret
CHATWOOT_BOT_ONLY_WHEN_PENDING=true

# LLM — https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Pinecone (FAQ Vector DB)
PINECONE_API_KEY=

# Redis vector store (rag/rag.py)
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v5-omni-small
JINA_EMBEDDING_DIMENSIONS=768
REDIS_VECTOR_INDEX=store-policies-jina
REDIS_GUARDRAIL_INDEX=customer-support-guardrails-jina
GUARDRAIL_DATASET_PATH=data/vectorstore_guardrails/customer_support_guardrail_examples.jsonl

# Infra (matches docker-compose.yml)
DATABASE_URL=
REDIS_URL=

# Behavior
DEBOUNCE_SECONDS=10
HISTORY_MAX_MESSAGES=30

# Queue (Redis Streams)
QUEUE_ENABLED=true
REDIS_STREAM=webhook:inbound
REDIS_STREAM_GROUP=webhook-consumers
# Seconds an unacked entry must be idle before it is considered orphaned and
# reclaimed. MUST exceed worst-case turn duration (debounce + LLM + retries).
QUEUE_RECLAIM_MIN_IDLE_S=180
QUEUE_MAX_ATTEMPTS=3
QUEUE_MAXLEN=10000
